# Reference template only. Keep real values in the backend secret manager.
PORT=3001
NVIDIA_API_KEY=
# Model team: GLM plans/calls tools; Nemotron analyzes; Muse reviews the draft.
# GLM planner: temperature=0.5, top_p=1, max_tokens=1024.
# Nemotron analyst: temperature=1, top_p=0.95, max_tokens=16384, thinking enabled.
# Muse reviewer: temperature=1, top_p=0.95, max_tokens=8192.
NVIDIA_GLM_MODEL=z-ai/glm-5.3
NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_MUSE_MODEL=meta/muse-glimmer-30b
# Backward-compatible alias for the GLM planner model only.
# NVIDIA_MODEL=z-ai/glm-5.3
NVIDIA_REASONING_EFFORT=max
# Optional OpenAI-compatible NVIDIA NIM endpoint override (for example, a self-hosted deployment).
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
# Optional: path to artifacts/agri-lens-ai/src/data when the repository layout differs.
# AGRILENS_DATA_DIR=
