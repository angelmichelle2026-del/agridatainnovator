# Reference template only. Keep real values in the backend secret manager.
PORT=3001
NVIDIA_API_KEY=
# GLM-5.3 is the default because NVIDIA lists Kimi K3 as no longer supported after 2026-10-15.
NVIDIA_MODEL=z-ai/glm-5.3
NVIDIA_REASONING_EFFORT=max
# Optional OpenAI-compatible NVIDIA NIM endpoint override (for example, a self-hosted deployment).
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
# Optional: path to artifacts/agri-lens-ai/src/data when the repository layout differs.
# AGRILENS_DATA_DIR=
